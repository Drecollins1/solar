# Contact form delivery via Resend (https://resend.com). Copy to .env.local.
# Without these, dev mode logs submissions to the console and production shows
# an error that points visitors to phone/WhatsApp instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional — must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Solvera Website <website@yourdomain.com>"
